0 // Passo 1: Motor A deitado, saída para a direita. Eixo de 6 na saída e as duas rodas grandes lado a lado.
1 15 -90 0 0 0 -1 0 1 0 0 0 0 1 68488.dat
1 4 0 0 0 1 0 0 0 1 0 0 0 1 3706.dat
1 15 -20 0 0 0 0 1 0 1 0 -1 0 0 65834p01.dat
1 15 15 0 0 0 0 1 0 1 0 -1 0 0 65834p01.dat
0 STEP
0 // Passo 2: Do lado esquerdo do motor A: 4 pinos e duas vigas em pé (11 na frente, 7 atrás). A ponta de baixo é o apoio.
1 0 -120 -20 0 1 0 0 0 1 0 0 0 1 61332.dat
1 0 -120 20 0 1 0 0 0 1 0 0 0 1 61332.dat
1 0 -120 -20 60 1 0 0 0 1 0 0 0 1 61332.dat
1 0 -120 20 60 1 0 0 0 1 0 0 0 1 61332.dat
1 26 -130 -60 0 0 1 0 0 0 1 1 0 0 32525.dat
1 1 -130 -20 60 0 1 0 0 0 1 1 0 0 32524.dat
0 STEP
0 // Passo 3: Hub pequeno (com a bateria) deitado em cima do motor A, preso na viga de 11 com 2 pinos.
1 0 -120 -100 0 1 0 0 0 1 0 0 0 1 61332.dat
1 0 -120 -80 0 1 0 0 0 1 0 0 0 1 61332.dat
1 14 -50 -70 20 1 0 0 0 1 0 0 0 1 67351.dat
1 14 -50 -70 20 1 0 0 0 1 0 0 0 1 66757.dat
0 STEP
0 // Passo 4: Em cima do hub: 2 pinos e uma viga de 7 deitada.
1 0 -110 -150 -20 0 -1 0 1 0 0 0 0 1 61332.dat
1 0 10 -150 -20 0 -1 0 1 0 0 0 0 1 61332.dat
1 1 -50 -160 -20 0 0 1 0 1 0 -1 0 0 32524.dat
0 STEP
0 // Passo 5: Motor B deitado em cima da viga de 7 (2 pinos), saída para a direita.
1 0 -70 -170 -20 0 -1 0 1 0 0 0 0 1 61332.dat
1 0 -30 -170 -20 0 -1 0 1 0 0 0 0 1 61332.dat
1 15 -50 -200 0 0 -1 0 1 0 0 0 0 1 68488.dat
0 STEP
0 // Passo 6: Alavanca: eixo de 7 na saída do motor B e, na ponta dele, a viga dobrada (furo de eixo), reta para a frente.
1 14 50 -200 0 1 0 0 0 1 0 0 0 1 44294.dat
1 25 110 -200 0 0 -1 0 -1 0 0 0 0 -1 6629.dat
0 STEP
0 // Passo 7: Viga de 11 por fora da viga dobrada (2 pinos), indo para a frente.
1 0 120 -200 -20 1 0 0 0 1 0 0 0 1 61332.dat
1 0 120 -200 -40 1 0 0 0 1 0 0 0 1 61332.dat
1 26 130 -200 -120 0 1 0 -1 0 0 0 0 1 32525.dat
0 STEP
0 // Passo 8: Gancho: viga em L com a perna curta na ponta da viga de 11 (2 pinos) e a perna longa para baixo.
1 0 140 -200 -220 1 0 0 0 1 0 0 0 1 61332.dat
1 0 140 -200 -180 1 0 0 0 1 0 0 0 1 61332.dat
1 10 150 -120 -220 0 -1 0 0 0 -1 1 0 0 32526.dat
0 STEP
0 // Passo 9: Pé do gancho: outra viga em L presa no poste (2 pinos), com o pé virado para a FRENTE.
1 0 160 -140 -220 1 0 0 0 1 0 0 0 1 61332.dat
1 0 160 -120 -220 1 0 0 0 1 0 0 0 1 61332.dat
1 10 170 -140 -220 0 -1 0 0 0 1 -1 0 0 32526.dat
