0 // Passo 1: Base: placa 16x16 (o chão do parque).
1 15 0 0 0 1 0 0 0 1 0 0 0 1 91405.dat
0 STEP
0 // Passo 2: Dois tijolos Technic 1x4 deitados, um de cada lado do meio, e o motor pequeno em pé (porta A) entre eles, preso com 2 pinos.
1 26 -30 -24 0 0 0 1 0 1 0 -1 0 0 3701.dat
1 26 50 -24 0 0 0 1 0 1 0 -1 0 0 3701.dat
1 0 -20 -14 -20 1 0 0 0 1 0 0 0 1 61332.dat
1 0 40 -14 20 1 0 0 0 1 0 0 0 1 61332.dat
1 15 10 -34 0 -1 0 0 0 1 0 0 0 -1 68488.dat
0 STEP
0 // Passo 3: Hub na frente, preso no lado esquerdo a um tijolo Technic 1x4 (em cima de um tijolo 1x4) com 2 pinos (a bateria vai embaixo do hub).
1 25 -130 -24 100 0 0 1 0 1 0 -1 0 0 3010.dat
1 26 -130 -48 100 0 0 1 0 1 0 -1 0 0 3701.dat
1 0 -120 -38 80 1 0 0 0 1 0 0 0 1 61332.dat
1 0 -120 -38 120 1 0 0 0 1 0 0 0 1 61332.dat
1 14 -50 -8 100 1 0 0 0 1 0 0 0 1 67351.dat
1 14 -50 -8 100 1 0 0 0 1 0 0 0 1 66757.dat
0 STEP
0 // Passo 4: A torre da luz: dois tijolos Technic 1x4 empilhados no fundo à esquerda e a matriz de luz presa com 2 pinos.
1 26 -100 -24 -130 1 0 0 0 1 0 0 0 1 3701.dat
1 26 -100 -48 -130 1 0 0 0 1 0 0 0 1 3701.dat
1 0 -120 -38 -120 0 0 -1 0 1 0 1 0 0 61332.dat
1 0 -80 -38 -120 0 0 -1 0 1 0 1 0 0 61332.dat
1 322 -100 -38 -110 -1 0 0 0 1 0 0 0 -1 47592.dat
0 STEP
0 // Passo 5: Eixo de 6 no motor. Tijolo redondo 2x2 no eixo e a placa 8x8 por cima: é o disco que gira.
1 4 10 -100 0 0 -1 0 1 0 0 0 0 1 3706.dat
1 2 10 -108 0 1 0 0 0 1 0 0 0 1 3941.dat
1 15 10 -116 0 1 0 0 0 1 0 0 0 1 41539.dat
0 STEP
